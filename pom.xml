<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>pe.farmaguard</groupId>
    <artifactId>farmaguard</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>FarmaGuard</name>
    <description>Asistente de Compras Seguras de Farmacia</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
        <flatlaf.version>3.5.2</flatlaf.version>
    </properties>

    <dependencies>
        <!-- Spring Data JPA (Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver SQLite (base de datos en archivo local .db) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <!-- Dialecto SQLite para Hibernate 6 (org.hibernate.community.dialect.SQLiteDialect) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- Interfaz Swing moderna -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>farmaguard</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Instalador de Windows con Java incluido:  mvnw.cmd -Pexe clean package
            Resultado: target/dist/FarmaGuard-<versión>.exe (requiere WiX Toolset instalado para generarlo).
            Se instala por usuario (sin pedir permisos de administrador) y crea accesos directos
            en el Escritorio y en el menú Inicio. El UUID de actualización no debe cambiar: permite
            que una versión nueva reemplace a la anterior en lugar de instalarse dos veces.
        -->
        <profile>
            <id>exe</id>
            <properties>
                <jpackage.tipo>exe</jpackage.tipo>
                <jpackage.entrada>${project.build.directory}/jpackage-entrada</jpackage.entrada>
                <jpackage.destino>${project.build.directory}/dist</jpackage.destino>
            </properties>
            <build>
                <plugins>
                    <!-- jpackage empaqueta todo lo que hay en la carpeta de entrada: se deja solo el JAR -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>preparar-jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${jpackage.entrada}"/>
                                        <delete dir="${jpackage.destino}"/>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${jpackage.entrada}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${jpackage.tipo}</argument>
                                        <argument>--name</argument>
                                        <argument>FarmaGuard</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>FarmaGuard</argument>
                                        <argument>--description</argument>
                                        <argument>${project.description}</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/packaging/farmaguard.ico</argument>
                                        <argument>--input</argument>
                                        <argument>${jpackage.entrada}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument>
                                        <argument>${jpackage.destino}</argument>
                                        <!-- sqlite-jdbc carga una librería nativa: se habilita para evitar avisos -->
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                                        <argument>--win-per-user-install</argument>
                                        <argument>--win-dir-chooser</argument>
                                        <argument>--win-shortcut</argument>
                                        <argument>--win-menu</argument>
                                        <argument>--win-menu-group</argument>
                                        <argument>FarmaGuard</argument>
                                        <argument>--win-upgrade-uuid</argument>
                                        <argument>0e42405a-2ab4-4d82-8bb1-0ae6340eaa4a</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-header-files --no-man-pages</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
